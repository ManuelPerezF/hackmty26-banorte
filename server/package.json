{
  "name": "banorte-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run mcp:build && nest start --watch",
    "build": "nest build && npm run mcp:build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p ../mcp/tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "check": "npm run typecheck && npm run build",
    "mcp:build": "tsc -p ../mcp/tsconfig.json",
    "rag:ingest": "node dist/modules/conocimiento/ingest.cli.js",
    "test:adaptive": "node scripts/verify-adaptive.cjs",
    "test:model-plans": "node scripts/verify-model-plans.cjs",
    "test:rag-plan": "node scripts/verify-rag-plan.cjs",
    "test:topic-switch": "node scripts/verify-topic-switch.cjs",
    "test:a2ui-actions": "node scripts/verify-a2ui-actions.cjs",
    "test:goal-plans": "node scripts/verify-goal-plans.cjs",
    "test:llm-tool-guard": "node scripts/verify-llm-tool-guard.cjs",
    "test:planeacion": "node scripts/verify-planeacion.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "^0.45.1",
    "cookie": "^1.1.1",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.2"
  },
  "overrides": {
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.0",
    "prisma": "7.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
