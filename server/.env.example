NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://banorte:banorte_local_demo@127.0.0.1:5433/banorte?schema=public
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
BUSINESS_TIMEZONE=America/Monterrey
COOKIE_SECURE=false
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30
# Opcional: habilitar el propietario inicial al ejecutar db:seed.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Configura la clave para habilitar mensajes del agente.
GEMINI_API_KEY=
# Proveedor principal del chat. Gemini usa GEMINI_API_KEY.
LLM_PROVIDER=gemini
# Fallback opcional del chat; none evita cambiar silenciosamente de proveedor.
LLM_FALLBACK_PROVIDER=none
LLM_BASE_URL=http://127.0.0.1:1234/v1
# Opcional: ID del modelo cargado en LM Studio. Si se omite, se usa el primero de /v1/models.
LOCAL_LLM_MODEL=
# RAG: modelo fijo compatible con los vectores de 768 dimensiones.
RAG_EMBEDDING_MODEL=gemini-embedding-001
# Modelo de respaldo Gemini y, si se configura, proveedor único cuando LLM_PROVIDER=gemini.
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_MS=90000
MCP_ENTRY=../mcp/dist/server.js

# Segunda cuenta de prueba, aprovisionada únicamente por seed.
SECOND_TEST_EMAIL=
SECOND_TEST_PASSWORD=
